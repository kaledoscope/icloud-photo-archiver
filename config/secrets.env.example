# =============================================================
# O-Data-Center-System — 保密配置（模板）
# =============================================================
# 复制为 config/secrets.env 后填写。
#
# ⚠️ 本文件【绝不能】提交到仓库，也不该离开这台机器。
#    .gitignore 已经排除 config/secrets.env，但复制/备份时要自己留意。
#
# 判断标准：泄露了会直接造成损失或暴露个人信息的，放这里。
#   邮箱授权码 → 能拿去发垃圾邮件
#   内网地址   → 暴露你的网络拓扑
#   SSH 私钥路径 → 指向可登录你 NAS 的钥匙
# 其余（路径、开关、阈值）放 config/config.env。
#
# 优先级:  环境变量  >  config.env  >  本文件  >  代码默认值
# 所以同一个键在这里和 config.env 都写了的话，config.env 赢。
# 不要把同一个键两边都写。
# =============================================================

# =============================================================
# 邮件通知（SMTP）
# =============================================================
# QQ 邮箱: smtp.qq.com，密码填「授权码」
#          设置 → 账户 → POP3/SMTP服务 → 开启 → 生成授权码
# Gmail:   smtp.gmail.com，密码填「应用专用密码」
export EMAIL_SMTP_HOST="smtp.qq.com"
export EMAIL_SMTP_PORT=587
export EMAIL_FROM="your_account@qq.com"
export EMAIL_TO="your_account@gmail.com"
export EMAIL_PASSWORD="在这里填授权码"

# =============================================================
# 群晖 NAS
# =============================================================
# 填完后记得把 config/config.env 里的 NAS_ENABLED 改成 true
export NAS_IP="192.168.1.100"
export NAS_MAC="00:11:32:AA:BB:CC"
export NAS_USER="your_nas_user"

# 能登录 NAS 的 SSH 私钥（用于等待就绪和发送关机指令）
export SSH_KEY="/Users/your_user/.ssh/id_ed25519_synology"
