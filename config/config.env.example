# =============================================================
# O-Data-Center-System — 公用配置（模板）
# =============================================================
# 复制为 config/config.env 后按你的环境修改。
# 本文件会被 git 忽略，不会进仓库。
#
# 本文件放「可以公开、方便随时改」的值：路径、开关、阈值、时间参数。
# 涉及个人信息的（邮箱授权码、内网地址、SSH 密钥）放 config/secrets.env。
#
# 优先级:  环境变量  >  本文件  >  secrets.env  >  代码默认值
#   临时改一下不用编辑文件，例如:
#     BACKUP_ROOT=/tmp/try bash modules/scheduler/photo_backup_weekly.sh --test
# =============================================================

# ---- 本地中转目录 ----
# 导出照片的落地目录，也是 rsync 的源。这不是永久存储，超期的会被清理。
export BACKUP_ROOT="/Users/your_user/PhotoBackup"

# ---- Python 解释器 ----
# 必须是装了 osxphotos、且在「系统设置 → 隐私与安全性 → 全磁盘访问权限」
# 里被添加过的那个。用 `which -a python3.11` 看清楚有哪几个，别选错。
export PYTHON_BIN="/opt/homebrew/bin/python3.11"

# ---- Photos 库位置 ----
# 只在非默认位置时才需要改
# export PHOTOS_LIBRARY_PATH="$HOME/Pictures/Photos Library.photoslibrary"

# =============================================================
# 备份目标
# =============================================================
# 流水线要同步到哪些地方。每个目标需要有两样东西:
#   1. 清单标记字段   自动生成为 backed_up_<目标名>
#   2. 远端路径       REMOTE_<目标名大写>_DIR
# 增删目标只改这里 + 对应路径，不需要改任何代码。
export BACKUP_TARGETS="115,nas"

# 清理本地文件前，必须先确认哪些目标已完成备份。
# 只写 115 是有意的：NAS 常年离线，把它列为前置条件会让清理永远不触发。
export CLEANUP_REQUIRE_TARGETS="115"

# ---- 115 网盘（CloudDrive2 挂载）----
export CLOUDDRIVE_MOUNT="/Volumes/CloudDrive"
export REMOTE_115_DIR="${CLOUDDRIVE_MOUNT}/PhotoBackup"
export CLOUDDRIVE_BIN="/Applications/CloudDrive/clouddrive"

# =============================================================
# 群晖 NAS 冷备
# =============================================================
# 总开关。false 时 NAS 相关步骤直接跳过。
# NAS 的 IP / MAC / 用户名 / SSH 密钥在 config/secrets.env 里填。
export NAS_ENABLED=false

export NAS_SHARE="photo_backup"
export NAS_MOUNT_POINT="/Volumes/NAS_Backup"
export REMOTE_NAS_DIR="${NAS_MOUNT_POINT}/PhotoBackup"

# 冷备间隔（周）。4 = 每 4 周一次；0 = 关闭周期性冷备
export NAS_BACKUP_WEEKS_INTERVAL=4

# 启动等待参数
export NAS_MAX_WAIT_SEC=300       # 等 SSH 就绪的上限（秒）
export NAS_WAIT_INTERVAL=10       # 轮询间隔（秒）
export NAS_MAX_WOL_RETRIES=3      # WOL 重试次数
export NAS_WOL_RETRY_DELAY=300    # 两次 WOL 之间的等待（秒）
export NAS_PING_WAIT_SEC=60       # 单次 WOL 后等 ping 多久（秒）

# =============================================================
# 分类规则
# =============================================================
# 家庭共享相簿名称（逗号分隔），命中这些名字的 → family-shared
export FAMILY_ALBUMS="Family,家庭,家人共享,家庭聚会,共享相簿"

# 没有 EXIF 设备信息的文件（网站/App 存的图）归到哪个文件夹。
# 建议设成你的主力机型；留空则归到 Unknown_Device
export DEFAULT_DEVICE_MODEL="iPhone_15_Pro"

# 导出窗口（月）：只导出最近 N 个月的照片。--full 模式不受此限制
export EXPORT_WINDOW_MONTHS=3

# 设备型号映射表路径，留空用项目内置的 config/device-models.json
# export DEVICE_MODELS_PATH="config/device-models.json"

# =============================================================
# 清理策略
# =============================================================
# 本地中转目录保留月数：早于此期限、且已确认备份的月份目录会被清理
export STAGING_RETENTION_MONTHS=3

# 清理方式: trash = 移入废纸篓（可恢复，默认）| delete = 直接删除
# 注意 trash 模式下如果废纸篓不可写，目录会被【保留】，不会退化成硬删除
export STAGING_DELETE_MODE="trash"

# Photos.app 中照片保留月数（这一步只出报告，实际删除由你手动做）
export PHOTOS_APP_RETENTION_MONTHS=3

# 是否生成 iCloud/Photos 可清理报告
export ENABLE_ICLOUD_CLEANUP=true

# =============================================================
# 传输参数
# =============================================================
export RSYNC_TIMEOUT=300          # I/O 超时（秒）
export RSYNC_CONTIMEOUT=60        # 连接超时（秒）
export MAX_RETRIES=3              # rsync 失败重试次数
export RETRY_DELAY=300            # 重试间隔（秒）

# =============================================================
# 通知
# =============================================================
# 邮件总开关。SMTP 账号密码在 config/secrets.env
export EMAIL_ENABLED=true

# =============================================================
# 日志
# =============================================================
export LOG_LEVEL="INFO"           # DEBUG | INFO | WARN | ERROR
